# Apply Skill — example environment
#
# Copy to .env and fill in your values. Never commit .env.

# Discovery Engine — companion project that scrapes jobs into Supabase.
# Local default; override for hosted DE.
DE_BASE_URL=http://localhost:8091

# Per-consumer API key for Discovery Engine. Generate via DE config/api-keys.yaml.
APPLY_API_KEY=

# Hunter.io — used by Phase 3 to find a hiring contact at the target company.
# Free plan: 50 searches/month, limit<=10 per call. Optional but recommended.
HUNTER_API_KEY=

# Where the skill writes resolved profile + applications.
# Defaults to ./profile and ./applications inside the repo using the skill.
CAREER_DIR=./

# Browser binary used for HTML -> PDF conversion (Phase 4 pipeline A).
# Linux: /usr/bin/google-chrome
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_BIN=